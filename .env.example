# ── Threease QA harness — MẪU env. Copy file này thành .env rồi điền giá trị THẬT.
#    Giá trị xin team lead. .env bị gitignore — TUYỆT ĐỐI không commit creds.
#    pw_lib.js tự nạp .env (ở repo root threease_qa/). Chi tiết: docs/SETUP.md §A3.

# Pro (Nuxt) + Reservation — HTTP basic auth
BASIC_USER=
BASIC_PASS=

# Pro login — institute code / therapist code / password
INST=
THER=
PW=

# Ticket app (Django) login — institute / staff / password
TK_INST=
TK_STAFF=
TK_PW=

# Ticket Django admin
TK_ADMIN_USER=
TK_ADMIN_PASS=

# (tuỳ chọn) override URL/hành vi — mặc định đã có sẵn trong pw_lib.js, chỉ set khi cần:
# BASE_URL=  TICKET_URL=  TICKET_ADMIN_URL=  API_BASE=  LOCALE=ja-JP  HEADED=1  NO_STATE=1
